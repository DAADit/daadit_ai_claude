<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_claude_model_list" model="ir.ui.view">
        <field name="name">daadit.ai.claude.model.list</field>
        <field name="model">daadit.ai.claude.model</field>
        <field name="arch" type="xml">
            <list string="Claude models" editable="bottom">
                <header>
                    <button name="action_sync_now" type="object"
                            string="Refresh from Anthropic" class="btn-primary"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="technical_name"/>
                <field name="display_name"/>
                <field name="synced_from_api"/>
                <field name="last_synced"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_claude_model_form" model="ir.ui.view">
        <field name="name">daadit.ai.claude.model.form</field>
        <field name="model">daadit.ai.claude.model</field>
        <field name="arch" type="xml">
            <form string="Claude model">
                <header>
                    <button name="action_sync_now" type="object"
                            string="Refresh from Anthropic" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="technical_name"/>
                        <field name="display_name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="synced_from_api" readonly="1"/>
                        <field name="last_synced" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_claude_model" model="ir.actions.act_window">
        <field name="name">Claude Models</field>
        <field name="res_model">daadit.ai.claude.model</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Claude models yet</p>
            <p>Use <b>Refresh from Anthropic</b> to pull the current model
               list from the Anthropic API. This runs daily automatically.</p>
        </field>
    </record>

    <menuitem id="menu_claude_model"
              name="Claude Models"
              parent="ai_app.ai_config_menu"
              action="action_claude_model"
              sequence="90"
              groups="base.group_system"/>
</odoo>
